// ============================================================
// Reglas de seguridad de Firestore
// ------------------------------------------------------------
// Como la app NO tiene login, cualquiera con el enlace puede usarla.
// Estas reglas son la "puerta" que decide qué se permite:
//   - Todos pueden LEER paraderos y reportes.
//   - Todos pueden CREAR un reporte, pero solo si viene bien formado.
//   - Nadie puede EDITAR ni BORRAR desde la app (solo desde la consola).
// Se publican en: Firebase → Firestore Database → pestaña "Reglas".
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Paraderos: solo lectura. Se crean con sembrar.html (en modo de prueba)
    // o desde la consola de Firebase.
    match /paraderos/{paraderoId} {
      allow read: if true;
      allow write: if false;
    }

    // Reportes: lectura libre, creación validada, sin edición ni borrado.
    match /reportes/{reporteId} {
      allow read: if true;
      allow create: if reporteValido(request.resource.data);
      allow update, delete: if false;
    }

    function reporteValido(d) {
      return
        // Exactamente estos 4 campos, ni uno más ni uno menos
        d.keys().hasOnly(['paraderoId', 'categoria', 'descripcion', 'creadoEn'])
        && d.keys().hasAll(['paraderoId', 'categoria', 'descripcion', 'creadoEn'])
        // El paradero debe existir en la colección "paraderos"
        && d.paraderoId is string
        && exists(/databases/$(database)/documents/paraderos/$(d.paraderoId))
        // Solo categorías conocidas (igual que en js/catalogos.js)
        && d.categoria in ['hurto', 'alumbrado', 'zona_oscura', 'acoso', 'otro']
        // Descripción: texto de máximo 280 caracteres (puede ir vacía)
        && d.descripcion is string
        && d.descripcion.size() <= 280
        // La hora debe ser la del servidor (nadie puede inventar fechas)
        && d.creadoEn == request.time;
    }
  }
}
